#!/usr/bin/env bash
set -euo pipefail

shopt -s nullglob

BASE="${MULTIGRAVITY_HOME:-$HOME/AntigravityProfiles}"
REAL_HOME="$HOME"
cmd="${1-}"

# ── helpers ──────────────────────────────────────────────────────────────────

abort() {
  echo "Error: $1" >&2
  exit 1
}

print_info() {
  echo "$1"
}

# ── path helpers ─────────────────────────────────────────────────────────────

profile_dir() {
  printf '%s/%s\n' "$BASE" "$1"
}

templates_dir() {
  printf '%s/.templates\n' "$BASE"
}

is_shared_profile() {
  [ -f "$(profile_dir "$1")/.shared" ]
}

mac_shortcut_path() {
  printf '%s/Applications/Multigravity %s.app\n' "$REAL_HOME" "$1"
}

validate_name() {
  local name=$1

  if [[ -z "$name" ]]; then
    abort "profile name required"
  fi

  if ! [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ ]]; then
    abort "profile name must start with alphanumeric and contain only letters, numbers, or hyphens"
  fi
}

# ── app data paths ───────────────────────────────────────────────────────────

agy_data_dir() {
  printf '%s/Library/Application Support/Antigravity\n' "$1"
}

ide_data_dir() {
  printf '%s/Library/Application Support/Antigravity IDE\n' "$1"
}

ide_extensions_dir() {
  printf '%s/.antigravity-ide/extensions\n' "$1"
}

system_ide_data_dir() {
  printf '%s/Library/Application Support/Antigravity IDE\n' "$REAL_HOME"
}

system_ide_extensions_dir() {
  printf '%s/.antigravity-ide/extensions\n' "$REAL_HOME"
}

# ── app discovery ────────────────────────────────────────────────────────────

command_or_path() {
  local candidate=$1

  if [ -z "$candidate" ]; then
    return 1
  fi

  if [ -d "$candidate" ] || [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  if command -v "$candidate" >/dev/null 2>&1; then
    command -v "$candidate"
    return 0
  fi

  return 1
}

find_agy_app() {
  local override="${MULTIGRAVITY_AGY-}"
  if [ -n "$override" ] && command_or_path "$override" >/dev/null 2>&1; then
    command_or_path "$override"
    return 0
  fi

  local candidate
  for candidate in \
    "/Applications/Antigravity.app" \
    "$REAL_HOME/Applications/Antigravity.app"
  do
    if [ -d "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

find_ide_app() {
  local override="${MULTIGRAVITY_IDE-}"
  if [ -n "$override" ] && command_or_path "$override" >/dev/null 2>&1; then
    command_or_path "$override"
    return 0
  fi

  local candidate
  for candidate in \
    "/Applications/Antigravity IDE.app" \
    "$REAL_HOME/Applications/Antigravity IDE.app"
  do
    if [ -d "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

# ── profile layout ───────────────────────────────────────────────────────────

setup_isolated_keychain() {
  local profile_path=$1
  local kc_dir="$profile_path/Library/Keychains"
  local kc_file="$kc_dir/login.keychain-db"
  local bin_dir="$profile_path/bin"
  local shim="$bin_dir/security"

  # Remove old symlink if it was pointing to system Keychains
  if [ -L "$kc_dir" ]; then
    rm -f "$kc_dir"
  fi
  mkdir -p "$kc_dir" "$bin_dir"

  # Create dedicated profile login keychain if not exists
  if [ ! -f "$kc_file" ]; then
    /usr/bin/security create-keychain -p "" "$kc_file" 2>/dev/null || true
    /usr/bin/security set-keychain-settings "$kc_file" 2>/dev/null || true
  fi
  /usr/bin/security unlock-keychain -p "" "$kc_file" 2>/dev/null || true
  ln -sf "login.keychain-db" "$kc_dir/login.keychain"
  ln -sf "login.keychain-db" "$kc_dir/profile.keychain-db"

  # Install transparent security shim to isolate credentials per profile
  cat << EOF > "$shim"
#!/usr/bin/env bash
PROFILE_KC="$kc_file"
case "\$1" in
  find-generic-password|add-generic-password|delete-generic-password)
    for arg in "\$@"; do
      case "\$arg" in
        *.keychain|*.keychain-db)
          exec /usr/bin/security "\$@"
          ;;
      esac
    done
    exec /usr/bin/security "\$@" "\$PROFILE_KC"
    ;;
  *)
    exec /usr/bin/security "\$@"
    ;;
esac
EOF
  chmod +x "$shim"

  # Configure profile login shell environment (for Antigravity shell-env extraction)
  cat << EOF > "$profile_path/.zshenv"
export HOME="$profile_path"
export ZDOTDIR="$profile_path"
export PATH="$bin_dir:\$PATH"
EOF
}

setup_gemini_symlinks() {
  local profile_path=$1
  local gemini_dir="$profile_path/.gemini"
  local sys_gemini="$REAL_HOME/.gemini"

  mkdir -p "$gemini_dir/config"

  # Symlink agy binary
  if [ -e "$sys_gemini/bin" ] && [ ! -e "$gemini_dir/bin" ]; then
    ln -s "$sys_gemini/bin" "$gemini_dir/bin"
  fi

  # Symlink shared customizations in config (plugins, skills, MCP, sidecars)
  if [ -d "$sys_gemini/config" ]; then
    local item
    for item in mcp_config.json plugins skills sidecars; do
      if [ -e "$sys_gemini/config/$item" ] && [ ! -e "$gemini_dir/config/$item" ]; then
        ln -s "$sys_gemini/config/$item" "$gemini_dir/config/$item"
      fi
    done
  fi

  # Symlink shared files (global instructions, trusted folders)
  local f
  for f in GEMINI.md trustedFolders.json; do
    if [ -f "$sys_gemini/$f" ] && [ ! -e "$gemini_dir/$f" ]; then
      ln -s "$sys_gemini/$f" "$gemini_dir/$f"
    fi
  done
}

configure_ide_settings() {
  local profile_path=$1
  local ide_data_path
  ide_data_path="$(ide_data_dir "$profile_path")"
  local sys_ide_data
  sys_ide_data="$(system_ide_data_dir)"

  mkdir -p "$ide_data_path/User"

  # Copy settings.json instead of symlink so each profile can have dedicated serverArgs
  if [ -f "$sys_ide_data/User/settings.json" ]; then
    if [ -L "$ide_data_path/User/settings.json" ]; then
      rm -f "$ide_data_path/User/settings.json"
    fi
    if [ ! -f "$ide_data_path/User/settings.json" ]; then
      cp "$sys_ide_data/User/settings.json" "$ide_data_path/User/settings.json"
    fi
  fi

  # Inject --gemini_dir into Antigravity IDE configuration
  python3 -c "
import json, os
p = '$ide_data_path/User/settings.json'
data = {}
if os.path.exists(p):
    try:
        with open(p, 'r') as f:
            data = json.load(f)
    except Exception:
        pass
data['antigravity.serverArgs'] = ['--gemini_dir=$profile_path/.gemini']
os.makedirs(os.path.dirname(p), exist_ok=True)
with open(p, 'w') as f:
    json.dump(data, f, indent=2)
" 2>/dev/null || true
}

create_profile_layout() {
  local profile_path=$1

  mkdir -p "$profile_path"
  mkdir -p "$(agy_data_dir "$profile_path")"
  mkdir -p "$(ide_data_dir "$profile_path")"
  mkdir -p "$(ide_extensions_dir "$profile_path")"
  mkdir -p "$profile_path/Library/Application Support"

  setup_isolated_keychain "$profile_path"
  setup_gemini_symlinks "$profile_path"
  configure_ide_settings "$profile_path"
}

create_shared_layout() {
  local profile_path=$1

  mkdir -p "$profile_path"
  touch "$profile_path/.shared"

  # Isolated data dirs for account separation
  mkdir -p "$(agy_data_dir "$profile_path")"
  mkdir -p "$(ide_data_dir "$profile_path")"
  mkdir -p "$profile_path/Library/Application Support"

  setup_isolated_keychain "$profile_path"
  setup_gemini_symlinks "$profile_path"
  configure_ide_settings "$profile_path"

  # Share IDE extensions from system install instead of creating an empty dir
  local ext_dir sys_ext
  ext_dir="$(ide_extensions_dir "$profile_path")"
  sys_ext="$(system_ide_extensions_dir)"
  mkdir -p "$(dirname "$ext_dir")"
  if [ -d "$sys_ext" ]; then
    rm -rf "$ext_dir"
    ln -s "$sys_ext" "$ext_dir"
  else
    mkdir -p "$ext_dir"
  fi

  # Share IDE keybindings/snippets from system install
  local sys_ide_data ide_data_path
  sys_ide_data="$(system_ide_data_dir)"
  ide_data_path="$(ide_data_dir "$profile_path")"

  if [ -d "$sys_ide_data/User" ]; then
    local f
    for f in keybindings.json snippets; do
      if [ -e "$sys_ide_data/User/$f" ] && [ ! -e "$ide_data_path/User/$f" ]; then
        ln -s "$sys_ide_data/User/$f" "$ide_data_path/User/$f"
      fi
    done
  fi
}

# ── script path & quoting ───────────────────────────────────────────────────

script_path() {
  local installed dir

  installed="$(command -v multigravity 2>/dev/null || true)"
  if [ -n "$installed" ]; then
    printf '%s\n' "$installed"
    return 0
  fi

  dir="$(cd "$(dirname "$0")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$0")"
}

shell_quote() {
  printf '%q' "$1"
}

# ── shortcuts ────────────────────────────────────────────────────────────────

create_shortcut() {
  local profile=$1
  local app_name="Multigravity $profile"
  local app_dir run_script launcher icon_src

  app_dir="$(mac_shortcut_path "$profile")"
  run_script="$app_dir/Contents/MacOS/run"
  launcher="$(script_path)"
  icon_src="$(dirname "$launcher")/icon.icns"

  mkdir -p "$app_dir/Contents/MacOS"
  mkdir -p "$app_dir/Contents/Resources"

  cat <<EOF > "$run_script"
#!/usr/bin/env bash
export MULTIGRAVITY_HOME=$(shell_quote "$BASE")
exec $(shell_quote "$launcher") $(shell_quote "$profile") "\$@"
EOF

  chmod +x "$run_script"

  if [ -f "$icon_src" ]; then
    cp "$icon_src" "$app_dir/Contents/Resources/icon.icns"
  fi

  cat <<EOF > "$app_dir/Contents/Info.plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>run</string>
  <key>CFBundleIconFile</key>
  <string>icon</string>
  <key>CFBundleIdentifier</key>
  <string>com.multigravity.profile.$profile</string>
  <key>CFBundleName</key>
  <string>$app_name</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
</dict>
</plist>
EOF

  print_info "Shortcut created: $app_dir"
}

remove_shortcut() {
  local profile=$1
  local target

  target="$(mac_shortcut_path "$profile")"
  if [ -d "$target" ]; then
    rm -rf "$target"
    print_info "Removed shortcut: $target"
  fi
}

# ── launch ───────────────────────────────────────────────────────────────────

launch_profile() {
  local profile=$1
  shift || true

  local default_launch="${MULTIGRAVITY_DEFAULT_LAUNCH:-ide}"
  local launch_ide=false launch_app=false

  case "$default_launch" in
    both|all) launch_ide=true; launch_app=true ;;
    app|chat) launch_app=true ;;
    *)        launch_ide=true ;;
  esac

  local extra_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ide)
        launch_ide=true
        launch_app=false
        ;;
      --chat|--app)
        launch_app=true
        launch_ide=false
        ;;
      --both|--all)
        launch_ide=true
        launch_app=true
        ;;
      --)
        shift; extra_args=("$@"); break ;;
      *)
        extra_args+=("$1") ;;
    esac
    shift
  done

  local profile_path
  profile_path="$(profile_dir "$profile")"
  if [ ! -d "$profile_path" ]; then
    abort "profile '$profile' does not exist. Run: multigravity new $profile"
  fi

  # Ensure profile directories, symlinks, and keychain isolation are up to date
  if is_shared_profile "$profile"; then
    create_shared_layout "$profile_path"
  else
    create_profile_layout "$profile_path"
  fi

  local profile_bin="$profile_path/bin"
  local kc_file="$profile_path/Library/Keychains/login.keychain-db"
  if [ -f "$kc_file" ]; then
    /usr/bin/security unlock-keychain -p "" "$kc_file" 2>/dev/null || true
  fi

  if $launch_app; then
    local app_agy agy_dd
    if ! app_agy="$(find_agy_app)"; then
      abort "Antigravity.app not found. Install Antigravity or set MULTIGRAVITY_AGY."
    fi
    agy_dd="$(agy_data_dir "$profile_path")"
    print_info "Launching Antigravity (desktop) with profile '$profile'"
    unset ELECTRON_RUN_AS_NODE
    open -n \
      --env HOME="$profile_path" \
      --env ZDOTDIR="$profile_path" \
      --env PATH="$profile_bin:$PATH" \
      "$app_agy" --args \
      --user-data-dir="$agy_dd"
  fi

  if $launch_ide; then
    local app_ide ide_dd ext_dir ide_bin
    if ! app_ide="$(find_ide_app)"; then
      abort "Antigravity IDE.app not found. Install Antigravity IDE or set MULTIGRAVITY_IDE."
    fi
    ide_dd="$(ide_data_dir "$profile_path")"
    ext_dir="$(ide_extensions_dir "$profile_path")"
    ide_bin="$app_ide/Contents/Resources/app/bin/antigravity-ide"

    print_info "Launching Antigravity IDE with profile '$profile'"
    unset ELECTRON_RUN_AS_NODE
    if [ -x "$ide_bin" ]; then
      if [ ${#extra_args[@]} -gt 0 ]; then
        PATH="$profile_bin:$PATH" \
        HOME="$profile_path" \
        ZDOTDIR="$profile_path" \
        "$ide_bin" \
          --user-data-dir "$ide_dd" \
          --extensions-dir "$ext_dir" \
          -n \
          "${extra_args[@]}" >/dev/null 2>&1 &
      else
        PATH="$profile_bin:$PATH" \
        HOME="$profile_path" \
        ZDOTDIR="$profile_path" \
        "$ide_bin" \
          --user-data-dir "$ide_dd" \
          --extensions-dir "$ext_dir" \
          -n >/dev/null 2>&1 &
      fi
    else
      if [ ${#extra_args[@]} -gt 0 ]; then
        open -n \
          --env HOME="$profile_path" \
          --env ZDOTDIR="$profile_path" \
          --env PATH="$profile_bin:$PATH" \
          "$app_ide" --args \
          --user-data-dir "$ide_dd" \
          --extensions-dir "$ext_dir" \
          "${extra_args[@]}"
      else
        open -n \
          --env HOME="$profile_path" \
          --env ZDOTDIR="$profile_path" \
          --env PATH="$profile_bin:$PATH" \
          "$app_ide" --args \
          --user-data-dir "$ide_dd" \
          --extensions-dir "$ext_dir"
      fi
    fi
  fi
}

# ── list ─────────────────────────────────────────────────────────────────────

list_profiles() {
  local entries=""
  local dir
  local raw=${1-}

  if [ "$raw" != "--raw" ]; then
    echo "Existing profiles:"
  fi

  if [ ! -d "$BASE" ]; then
    if [ "$raw" != "--raw" ]; then
      echo "(none)"
    fi
    return 0
  fi

  for dir in "$BASE"/*; do
    [ -d "$dir" ] || continue
    local n
    n="$(basename "$dir")"
    [ "$n" = ".templates" ] && continue
    entries="${entries}${n}"$'\n'
  done

  if [ -z "$entries" ]; then
    if [ "$raw" != "--raw" ]; then
      echo "(none)"
    fi
  else
    printf '%s' "$entries" | sort
  fi
}

# ── new ──────────────────────────────────────────────────────────────────────

new_profile() {
  local profiles=() shared=true from_tpl=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --shared)              shared=true ;;
      --isolated|--full)     shared=false ;;
      --from)                from_tpl="${2-}"; shift ;;
      -*)                    abort "unknown option: $1" ;;
      *)                     profiles+=("$1") ;;
    esac
    shift
  done

  if [ ${#profiles[@]} -eq 0 ]; then
    abort "profile name required. Usage: multigravity new <name...> [--isolated] [--from <tpl>]"
  fi

  for profile in "${profiles[@]}"; do
    validate_name "$profile"

    local profile_path
    profile_path="$(profile_dir "$profile")"
    if [ -d "$profile_path" ]; then
      abort "profile '$profile' already exists"
    fi

    mkdir -p "$BASE"

    if [ -n "$from_tpl" ]; then
      local tpl_path
      tpl_path="$(templates_dir)/$from_tpl"
      [ -d "$tpl_path" ] || abort "template '$from_tpl' not found. Run: multigravity template list"
      print_info "Creating profile '$profile' from template '$from_tpl'..."
      cp -R "$tpl_path" "$profile_path"
      # Ensure .gemini symlinks are up to date even for template-based profiles
      setup_gemini_symlinks "$profile_path"
    elif [ "$shared" = true ]; then
      create_shared_layout "$profile_path"
    else
      create_profile_layout "$profile_path"
    fi

    local type_label="shared"
    [ "$shared" = false ] && type_label="isolated"
    print_info "Created $type_label profile '$profile'"
    create_shortcut "$profile"
  done
}

# ── delete ───────────────────────────────────────────────────────────────────

delete_profile() {
  local profile=$1
  local profile_path confirm

  validate_name "$profile"

  profile_path="$(profile_dir "$profile")"
  if [ ! -d "$profile_path" ]; then
    abort "profile '$profile' does not exist"
  fi

  read -r -p "Delete profile '$profile' and all its data? [y/N] " confirm
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    rm -rf "$profile_path"
    remove_shortcut "$profile"
    print_info "Deleted profile '$profile'"
  else
    print_info "Aborted."
  fi
}

# ── rename ───────────────────────────────────────────────────────────────────

rename_profile() {
  local old=$1
  local new=$2

  validate_name "$old"
  validate_name "$new"

  local old_path new_path
  old_path="$(profile_dir "$old")"
  new_path="$(profile_dir "$new")"

  if [ ! -d "$old_path" ]; then
    abort "profile '$old' does not exist"
  fi
  if [ -d "$new_path" ]; then
    abort "profile '$new' already exists"
  fi

  mv "$old_path" "$new_path"
  remove_shortcut "$old"
  create_shortcut "$new"

  print_info "Renamed profile '$old' to '$new'"
}

# ── clone ────────────────────────────────────────────────────────────────────

clone_profile() {
  local src=$1
  local dest=$2

  validate_name "$src"
  validate_name "$dest"

  local src_path dest_path
  src_path="$(profile_dir "$src")"
  dest_path="$(profile_dir "$dest")"

  if [ ! -d "$src_path" ]; then
    abort "source profile '$src' does not exist"
  fi
  if [ -d "$dest_path" ]; then
    abort "destination profile '$dest' already exists"
  fi

  print_info "Cloning profile '$src' to '$dest'..."
  cp -R "$src_path" "$dest_path"
  create_shortcut "$dest"

  print_info "Successfully cloned '$src' to '$dest'"
}

# ── doctor ───────────────────────────────────────────────────────────────────

doctor_cli() {
  local errors=0
  local warnings=0

  print_info "Checking multigravity environment..."

  # 1. Antigravity (desktop app)
  local app_agy
  if app_agy=$(find_agy_app); then
    echo "  [✓] Antigravity (desktop): Found at $app_agy"
  else
    echo "  [✗] Antigravity (desktop): Not found. Install Antigravity or set MULTIGRAVITY_AGY."
    errors=$((errors + 1))
  fi

  # 2. Antigravity IDE
  local app_ide
  if app_ide=$(find_ide_app); then
    echo "  [✓] Antigravity IDE: Found at $app_ide"
  else
    echo "  [✗] Antigravity IDE: Not found. Install Antigravity IDE or set MULTIGRAVITY_IDE."
    errors=$((errors + 1))
  fi

  # 3. Global binary
  local installed
  installed="$(command -v multigravity 2>/dev/null || true)"
  if [ -n "$installed" ]; then
    echo "  [✓] Global Binary: $installed"
  else
    echo "  [!] Global Binary: Not found in PATH. Run install script or update PATH."
    warnings=$((warnings + 1))
  fi

  # 4. Application Icon
  local icon_path
  icon_path="$(dirname "$(script_path)")/icon.icns"
  if [ -f "$icon_path" ]; then
    echo "  [✓] Application Icon: Found"
  else
    echo "  [!] Application Icon: Missing ($icon_path). Shortcuts will have default icons."
    warnings=$((warnings + 1))
  fi

  # 5. .gemini directory
  if [ -d "$REAL_HOME/.gemini" ]; then
    echo "  [✓] Gemini config: $REAL_HOME/.gemini"
  else
    echo "  [!] Gemini config: $REAL_HOME/.gemini not found. Profiles may not sync config properly."
    warnings=$((warnings + 1))
  fi

  # 6. agy binary
  if [ -x "$REAL_HOME/.gemini/bin/agy" ]; then
    echo "  [✓] AGY CLI: $REAL_HOME/.gemini/bin/agy"
  else
    echo "  [!] AGY CLI: Not found at $REAL_HOME/.gemini/bin/agy"
    warnings=$((warnings + 1))
  fi

  # 7. Profile storage
  if [ -d "$BASE" ]; then
    if [ -w "$BASE" ]; then
      echo "  [✓] Profile storage: $BASE (writable)"
    else
      echo "  [✗] Profile storage: $BASE (NOT writable)"
      errors=$((errors + 1))
    fi
  else
    echo "  [!] Profile storage: $BASE (Not yet created)"
  fi

  echo ""
  if [ $errors -eq 0 ]; then
    if [ $warnings -eq 0 ]; then
      print_info "✓ Your environment looks perfect!"
    else
      print_info "Found $warnings warning(s). Multigravity should still work, but some features might be degraded."
    fi
  else
    print_info "✗ Found $errors error(s) and $warnings warning(s). Please fix the errors above."
  fi
}

# ── stats ────────────────────────────────────────────────────────────────────

profile_stats() {
  if [ ! -d "$BASE" ]; then
    print_info "No profiles found."
    return 0
  fi

  print_info "Profile Storage Usage:"
  printf "%-20s %-10s %-10s\n" "PROFILE" "SIZE" "EXTENSIONS"
  printf "%-20s %-10s %-10s\n" "-------" "----" "----------"

  local dir
  for dir in "$BASE"/*; do
    [ -d "$dir" ] || continue
    local name
    name=$(basename "$dir")
    [ "$name" = ".templates" ] && continue

    local size
    size=$(du -sh "$dir" | cut -f1)

    local ext_count
    ext_count=$(ls -1 "$(ide_extensions_dir "$dir")" 2>/dev/null | wc -l | xargs)
    [ -z "$ext_count" ] && ext_count=0

    printf "%-20s %-10s %-10s\n" "$name" "$size" "$ext_count"
  done

  echo ""
  local total
  total=$(du -sh "$BASE" | cut -f1)
  print_info "Total usage: $total"
}

# ── status ───────────────────────────────────────────────────────────────────

is_app_running() {
  local data_dir=$1

  # Check for Electron SingletonLock file
  local lock_file="$data_dir/SingletonLock"
  if [ -L "$lock_file" ]; then
    local target
    target=$(readlink "$lock_file" 2>/dev/null || true)
    if [ -n "$target" ]; then
      local pid
      pid=$(echo "$target" | grep -oE '[0-9]+$' || true)
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        return 0
      fi
    fi
  fi

  # Fallback: check process list for user-data-dir argument
  if ps -eo args 2>/dev/null | grep -v grep | grep -qF "$data_dir"; then
    return 0
  fi

  return 1
}

status_profiles() {
  if [ ! -d "$BASE" ]; then
    print_info "No profiles found."
    return 0
  fi

  printf "%-18s %-8s %-8s %-12s %-20s %s\n" "PROFILE" "APP" "IDE" "TYPE" "LAST USED" "SIZE"
  printf "%-18s %-8s %-8s %-12s %-20s %s\n" "-------" "---" "---" "----" "---------" "----"

  local dir
  for dir in "$BASE"/*; do
    [ -d "$dir" ] || continue
    local name
    name="$(basename "$dir")"
    [ "$name" = ".templates" ] && continue

    # Check desktop app running state
    local app_running="no"
    local app_dd
    app_dd="$(agy_data_dir "$dir")"
    if is_app_running "$app_dd"; then
      app_running="yes"
    fi

    # Check IDE running state
    local ide_running="no"
    local ide_dd
    ide_dd="$(ide_data_dir "$dir")"
    if is_app_running "$ide_dd"; then
      ide_running="yes"
    fi

    local ptype="full"
    [ -f "$dir/.shared" ] && ptype="shared"

    local last_used
    last_used=$(stat -f "%Sm" -t "%Y-%m-%d %H:%M" "$dir" 2>/dev/null || echo "unknown")

    local size
    size="$(du -sh "$dir" 2>/dev/null | cut -f1)"

    local app_color ide_color reset="\033[0m"
    if [ "$app_running" = "yes" ]; then
      app_color="\033[32m"
    else
      app_color=""
      reset=""
    fi

    if [ "$ide_running" = "yes" ]; then
      ide_color="\033[32m"
    else
      ide_color=""
    fi

    printf "%-18s ${app_color}%-8s\033[0m ${ide_color}%-8s\033[0m %-12s %-20s %s\n" \
      "$name" "$app_running" "$ide_running" "$ptype" "$last_used" "$size"
  done
}

# ── templates ────────────────────────────────────────────────────────────────

template_cmd() {
  local subcmd="${1-}"
  shift || true

  case "$subcmd" in
    save)
      local profile="${1-}" tpl_name="${2-}"
      validate_name "$profile"
      validate_name "$tpl_name"
      local src_path tpl_dir tpl_path
      src_path="$(profile_dir "$profile")"
      [ -d "$src_path" ] || abort "profile '$profile' does not exist"
      tpl_dir="$(templates_dir)"
      tpl_path="$tpl_dir/$tpl_name"
      [ -d "$tpl_path" ] && abort "template '$tpl_name' already exists"
      mkdir -p "$tpl_dir"
      print_info "Saving '$profile' as template '$tpl_name'..."
      cp -R "$src_path" "$tpl_path"
      rm -f "$tpl_path/.shared"
      print_info "Saved template '$tpl_name'"
      ;;
    list)
      local tpl_dir
      tpl_dir="$(templates_dir)"
      echo "Templates:"
      if [ ! -d "$tpl_dir" ]; then
        echo "  (none)"
        return 0
      fi
      local any=false
      for d in "$tpl_dir"/*; do
        [ -d "$d" ] || continue
        any=true
        printf "  %-20s %s\n" "$(basename "$d")" "$(du -sh "$d" 2>/dev/null | cut -f1)"
      done
      [ "$any" = false ] && echo "  (none)"
      ;;
    delete)
      local tpl_name="${1-}"
      validate_name "$tpl_name"
      local tpl_path
      tpl_path="$(templates_dir)/$tpl_name"
      [ -d "$tpl_path" ] || abort "template '$tpl_name' does not exist"
      rm -rf "$tpl_path"
      print_info "Deleted template '$tpl_name'"
      ;;
    *)
      abort "usage: multigravity template <save|list|delete>"
      ;;
  esac
}

# ── export / import ──────────────────────────────────────────────────────────

export_profile() {
  local profile="${1-}" out="${2-}"
  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  [ -d "$profile_path" ] || abort "profile '$profile' does not exist"

  [ -z "$out" ] && out="./${profile}.tar.gz"

  print_info "Exporting '$profile' to $out ..."
  tar -czf "$out" -C "$BASE" "$profile"
  print_info "Done."
}

import_profile() {
  local archive="${1-}" profile="${2-}"

  [ -n "$archive" ] || abort "usage: multigravity import <archive.tar.gz> [name]"
  [ -f "$archive" ]  || abort "file not found: $archive"

  if [ -z "$profile" ]; then
    profile="$(tar -tzf "$archive" 2>/dev/null | head -1 | cut -d'/' -f1)"
    [ -n "$profile" ] || abort "cannot infer profile name from archive — pass a name explicitly"
  fi

  validate_name "$profile"

  local dest
  dest="$(profile_dir "$profile")"
  [ -d "$dest" ] && abort "profile '$profile' already exists — choose a different name or delete it first"

  mkdir -p "$BASE"
  print_info "Importing as '$profile'..."

  local top_dir
  top_dir="$(tar -tzf "$archive" 2>/dev/null | head -1 | cut -d'/' -f1)"
  tar -xzf "$archive" -C "$BASE"
  if [ -n "$top_dir" ] && [ "$top_dir" != "$profile" ] && [ -d "$BASE/$top_dir" ]; then
    mv "$BASE/$top_dir" "$dest"
  fi

  # Ensure .gemini symlinks are fresh after import
  setup_gemini_symlinks "$dest"
  create_shortcut "$profile"
  print_info "Imported profile '$profile'"
}

# ── update ───────────────────────────────────────────────────────────────────

update_cli() {
  local script_url="https://raw.githubusercontent.com/kbysiec/multigravity-cli/main/multigravity"
  local target
  target="$(script_path)"

  if [ -z "$target" ]; then
    abort "could not determine script path for update"
  fi

  print_info "Updating multigravity from $script_url ..."
  if curl -fsSL "$script_url" -o "$target.tmp"; then
    mv "$target.tmp" "$target"
    chmod +x "$target"
    print_info "Successfully updated multigravity!"
  else
    rm -f "$target.tmp"
    abort "failed to download update"
  fi
}

# ── completion ───────────────────────────────────────────────────────────────

help_completion() {
  echo "To enable autocompletion, add the following to your ~/.zshrc:"
  echo ""
  echo '  source <(multigravity completion zsh)'
  echo ""
  echo "Then restart your terminal or run: source ~/.zshrc"
}

generate_completion() {
  local shell_type=$1
  case "$shell_type" in
    zsh)
      cat <<'EOF'
#compdef multigravity
_multigravity() {
    local -a commands
    commands=(
        'new:Create a new profile'
        'list:List existing profiles'
        'status:Show running state per profile'
        'rename:Rename a profile'
        'delete:Delete a profile'
        'clone:Clone an existing profile'
        'template:Manage profile templates (save, list, delete)'
        'export:Pack a profile into a tar.gz archive'
        'import:Restore a profile from a tar.gz archive'
        'update:Update multigravity'
        'doctor:Run system diagnosis'
        'stats:Show profile storage usage'
        'completion:Setup shell completion'
        'help:Show help'
    )
    local curcontext="$curcontext" state line
    _arguments -C '1: :->command' '*: :->args'
    case $state in
        command)
            _describe -t commands 'multigravity command' commands
            local -a profiles
            profiles=($(multigravity list --raw 2>/dev/null))
            (( ${#profiles} > 0 )) && _describe -t profiles 'profile' profiles
            ;;
        args)
            case $line[1] in
                rename|delete|clone|help)
                    local -a profiles
                    profiles=($(multigravity list --raw 2>/dev/null))
                    (( ${#profiles} > 0 )) && _describe -t profiles 'profile' profiles
                    ;;
            esac
            ;;
    esac
}
_multigravity "$@"
EOF
      ;;
    bash)
      cat <<'EOF'
_multigravity_completions() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    opts="new list status rename delete clone template export import update doctor stats completion help"

    if [[ ${COMP_CWORD} -eq 1 ]] ; then
        local profiles=$(multigravity list --raw 2>/dev/null)
        COMPREPLY=( $(compgen -W "${opts} ${profiles}" -- "${cur}") )
        return 0
    fi

    case "${prev}" in
        delete|rename|clone)
            local profiles=$(multigravity list --raw 2>/dev/null)
            COMPREPLY=( $(compgen -W "${profiles}" -- "${cur}") )
            return 0
            ;;
    esac
}
complete -F _multigravity_completions multigravity
EOF
      ;;
  esac
}

# ── help ─────────────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
Usage: multigravity <command> [args]

Commands:
  new <name...> [options]     Create new profile(s) + desktop shortcut (shared by default)
      --isolated / --full     Fully isolate extensions & settings (clean slate)
      --shared                (Default) Share extensions & settings; isolate only accounts
      --from <template>       Seed from a saved template
  list                        List existing profiles
  status                      Show running state per profile (App + IDE)
  rename <old> <new>          Rename a profile (updates its shortcut)
  delete <name>               Delete a profile and all its data
  clone <src> <dest>          Copy an existing profile
  template save <profile> <name>   Save a profile as a reusable template
  template list               List saved templates
  template delete <name>      Delete a template
  export <name> [path]        Archive a profile to tar.gz
  import <archive> [name]     Restore a profile from a tar.gz archive
  update                      Update multigravity to the latest version
  doctor                      Run a system diagnosis
  stats                       Show storage usage per profile
  completion                  Show setup instructions for shell completion
  <name> [args...]            Launch Antigravity IDE (default) with the given profile
      --ide                   (Default) Launch only Antigravity IDE
      --chat / --app          Launch only Antigravity Desktop (Chat)
      --both / --all          Launch both Antigravity IDE + Desktop (Chat)
  help                        Show this help

Profile names: alphanumeric and hyphens only (e.g. work, personal, test-1)

Environment:
  MULTIGRAVITY_DEFAULT_LAUNCH Set default launch mode: 'ide' (default), 'both', or 'chat'
  MULTIGRAVITY_AGY            Override the Antigravity (desktop) app path
  MULTIGRAVITY_IDE            Override the Antigravity IDE app path
  MULTIGRAVITY_HOME           Override the profile storage directory
EOF
}

# ── main dispatch ────────────────────────────────────────────────────────────

case "$cmd" in
  new)
    shift
    new_profile "$@"
    ;;
  list)
    list_profiles "${2-}"
    ;;
  status)
    status_profiles
    ;;
  rename)
    rename_profile "${2-}" "${3-}"
    ;;
  delete)
    delete_profile "${2-}"
    ;;
  clone)
    clone_profile "${2-}" "${3-}"
    ;;
  template)
    shift
    template_cmd "$@"
    ;;
  export)
    export_profile "${2-}" "${3-}"
    ;;
  import)
    import_profile "${2-}" "${3-}"
    ;;
  update)
    update_cli
    ;;
  doctor)
    doctor_cli
    ;;
  stats)
    profile_stats
    ;;
  completion)
    if [ -n "${2-}" ]; then
      generate_completion "$2"
    else
      help_completion
    fi
    ;;
  help | --help | -h)
    usage
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    launch_profile "$cmd" "${@:2}"
    ;;
esac
